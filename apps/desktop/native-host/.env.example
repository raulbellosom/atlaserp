# Build-time only. No credentials. The wrapper reads process environment.
ATLAS_NATIVE_ENV=staging
# Development only (emulator: 10.0.2.2, device: LAN address).
ATLAS_NATIVE_DEV_ORIGIN=http://10.0.2.2:5173
# ANDROID_HOME=C:/Users/your-user/AppData/Local/Android/Sdk
# NDK_HOME=C:/Users/your-user/AppData/Local/Android/Sdk/ndk/<installed-version>
# Firebase Android build input: set in the root .env or process environment.
# ATLAS_ANDROID_GOOGLE_SERVICES_JSON=D:/path/to/atlaserp-v2/.secrets/firebase/google-services.json
# Never put the server service-account JSON in this variable.
